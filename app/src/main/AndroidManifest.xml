<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The cards go into the database of AnkiDroid. AnkiDroid asks the user for this one. -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- The two apps the card comes from and goes to. Android hides other apps without this list. -->
    <queries>
        <package android:name="com.ichi2.anki" />
        <package android:name="space.subread.dictionary" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
        <provider android:authorities="space.subread.dictionary.lookup" />
        <provider android:authorities="space.subread.dictionary.debug.lookup" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- The settings: AnkiDroid, the deck and the note type, the capture service, the audio. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The card. Four ways in: the text selection menu of Android ("Add to Anki" in the
            menu), the share sheet with a text or an image, and the ADD intent of another app
            such as SubRead Dictionary. It has no task of its own, so it opens over the app that
            sent the word, and it is see-through until the card shows.
        -->
        <activity
            android:name=".AddActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/add_label"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Sheet">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="space.subread.anki.action.ADD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Keeps the last text selection of another app and takes a screenshot at that moment.
            Off until the user turns it on in the accessibility settings. See CaptureService.
        -->
        <service
            android:name=".CaptureService"
            android:exported="true"
            android:label="@string/capture_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/capture" />
        </service>

        <!-- AnkiDroid reads the files of a card through this provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>
    </application>
</manifest>
